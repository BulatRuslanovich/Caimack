root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 2

[*.cs]
indent_style = tab
indent_size = 4
tab_width = 4
dotnet_indent_style = tab
dotnet_indent_size = 4

[*.{csproj,slnx,json,yml,yaml}]
indent_style = space
indent_size = 2